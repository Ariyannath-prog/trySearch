# Core Flask / database
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///searchable.db

# Website crawler
AUDIT_MAX_PAGES=12
AUDIT_PAGE_BYTES=800000
AUDIT_SITEMAP_BYTES=2000000
AUDIT_REQUEST_DELAY_SECONDS=0.05

# Crawl-grounded RAG index (content analysis only; not visibility measurement)
RAG_DOCUMENT_MAX_CHARS=60000
RAG_CHUNK_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30
RAG_MAX_CHUNKS_PER_PAGE=40
RAG_DEFAULT_TOP_K=6
RAG_MAX_CONTEXT_CHARS=16000

# Perplexity Search API + Agent API evidence
PERPLEXITY_API_KEY=
PERPLEXITY_AGENT_PRESET=low
PERPLEXITY_AGENT_MAX_OUTPUT_TOKENS=1200
PERPLEXITY_MAX_RESULTS=10
PERPLEXITY_SEARCH_CONTEXT=medium
PERPLEXITY_MAX_PROMPTS_PER_SCAN=25

# Optional open-weight recommendation and grounded RAG synthesis layer
# through Hugging Face Inference Providers
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=openai/gpt-oss-120b:preferred

# Optional local alternative (used when HF_TOKEN is empty)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=gpt-oss:20b

# Google Search Console read-only OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/analytics/integrations/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
GSC_ROW_LIMIT=2500

# Scheduled worker
ANALYTICS_JOB_BATCH=10
ANALYTICS_MAX_TRACKED_PROMPTS=100

# Gemini (Google AI Studio) - Flash-Lite with Search grounding.
# This is an API key from aistudio.google.com, NOT the GOOGLE_CLIENT_ID/SECRET
# above - those are Search Console OAuth and are a different credential.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
